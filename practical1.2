# -*- coding: utf-8 -*-
"""
Практична робота №1, частина 2 (додаткові бали).
Арифметика цілих чисел у системах числення з основами 2..16 "у стовпчик":
додавання, віднімання, множення, ділення (з дробовою частиною частки)
та віднімання через додатковий код (двійкова система).

Число зберігається як список цифр (старша цифра першою); всі дії виконуються
розряд за розрядом, без переходу в десяткову систему.

Приклади запуску:
  python part2_arithmetic.py 1342 + 1271 --base 8
  python part2_arithmetic.py 1010101001 / 1010111001 --base 2 --digits 12
  python part2_arithmetic.py 1011100010 c 1010101001 --base 2   (додатковий код)
  python part2_arithmetic.py            (інтерактивний режим)
  python part2_arithmetic.py --demo     (приклади варіанту 10)
  python part2_arithmetic.py --test     (самоперевірка)
Дії: +  -  x (або *)  /  c
"""
import argparse
import random
import sys

ALPHABET = "0123456789ABCDEF"


def use_utf8():
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8", errors="replace")
        except Exception:
            pass


class Num:
    """Невід'ємне ціле число в системі з основою base."""

    def __init__(self, digits, base):
        digits = list(digits)
        while len(digits) > 1 and digits[0] == 0:
            digits.pop(0)
        self.digits, self.base = digits or [0], base

    @classmethod
    def parse(cls, text, base):
        text = text.strip().upper()
        if not text or any(ch not in ALPHABET[:base] for ch in text):
            raise ValueError(f"'{text}' не є числом у системі з основою {base}")
        return cls([ALPHABET.index(ch) for ch in text], base)

    def __str__(self):
        return "".join(ALPHABET[d] for d in self.digits)

    def _key(self):
        return (len(self.digits), self.digits)

    def __lt__(self, other):
        return self._key() < other._key()

    def is_zero(self):
        return self.digits == [0]

    # ---- додавання з перенесенням ----
    def plus(self, other, log=None):
        a, b = self.digits[::-1], other.digits[::-1]
        out, carry = [], 0
        for i in range(max(len(a), len(b))):
            x = a[i] if i < len(a) else 0
            y = b[i] if i < len(b) else 0
            s = x + y + carry
            if log is not None:
                log.append(f"розряд {i}: {ALPHABET[x]} + {ALPHABET[y]}" + (" + 1" if carry else "")
                           + f" = {s} -> пишемо {ALPHABET[s % self.base]}, переносимо {s // self.base}")
            out.append(s % self.base)
            carry = s // self.base
        if carry:
            out.append(carry)
        return Num(out[::-1], self.base)

    # ---- віднімання з позикою ----
    def minus(self, other, log=None):
        if self < other:
            raise ValueError("зменшуване менше від'ємника; використайте дію c (додатковий код)")
        a, b = self.digits[::-1], other.digits[::-1]
        out, borrow = [], 0
        for i in range(len(a)):
            y = b[i] if i < len(b) else 0
            d = a[i] - y - borrow
            note = ""
            if d < 0:
                d, borrow, note = d + self.base, 1, f" (позичаємо {self.base})"
            else:
                borrow = 0
            if log is not None:
                log.append(f"розряд {i}: {ALPHABET[a[i]]} - {ALPHABET[y]}{note} -> пишемо {ALPHABET[d]}, позика {borrow}")
            out.append(d)
        return Num(out[::-1], self.base)

    # ---- множення ----
    def times_digit(self, d):
        out, carry = [], 0
        for x in reversed(self.digits):
            p = x * d + carry
            out.append(p % self.base)
            carry = p // self.base
        while carry:
            out.append(carry % self.base)
            carry //= self.base
        return Num(out[::-1], self.base)

    def times(self, other, log=None):
        total = Num([0], self.base)
        for shift, d in enumerate(reversed(other.digits)):
            if d == 0:
                continue
            part = Num(self.times_digit(d).digits + [0] * shift, self.base)
            if log is not None:
                log.append(f"цифра {ALPHABET[d]} (зсув {shift}): {self} * {ALPHABET[d]} -> {part}")
            total = total.plus(part)
        return total

    # ---- ділення ----
    def divide(self, other, count=0, log=None):
        """Повертає (ціла частина частки, цифри після коми, остача)."""
        if other.is_zero():
            raise ZeroDivisionError("ділення на нуль")
        rem, whole = Num([0], self.base), []
        for d in self.digits:
            rem = Num(rem.digits + [d], self.base)
            q = 0
            while not rem < other:
                rem = rem.minus(other)
                q += 1
            whole.append(q)
            if log is not None:
                log.append(f"знесено {ALPHABET[d]}: цифра частки {ALPHABET[q]}, остача {rem}")
        frac = []
        for i in range(count):
            if rem.is_zero():
                break
            rem = Num(rem.digits + [0], self.base)
            q = 0
            while not rem < other:
                rem = rem.minus(other)
                q += 1
            frac.append(q)
            if log is not None:
                log.append(f"цифра після коми №{i + 1}: {ALPHABET[q]}, остача {rem}")
        return Num(whole, self.base), "".join(ALPHABET[q] for q in frac), rem

    def __add__(self, o): return self.plus(o)
    def __sub__(self, o): return self.minus(o)
    def __mul__(self, o): return self.times(o)


# ---------- додатковий код (двійкова система) ----------
def bits_add(a, b):
    """Додавання двох списків бітів однакової довжини; повертає (сума, перенос)."""
    out, carry = [0] * len(a), 0
    for i in range(len(a) - 1, -1, -1):
        s = a[i] + b[i] + carry
        out[i], carry = s % 2, s // 2
    return out, carry


def complement_minus(x, y, bits=16, log=None):
    """x - y у двійковій системі через додатковий код у розрядній сітці bits."""
    xs, ys = Num.parse(x, 2).digits, Num.parse(y, 2).digits
    width = bits - 1
    if max(len(xs), len(ys)) > width:
        raise ValueError(f"числа не вміщуються в сітку {bits} біт")
    pad = lambda ds: [0] * (width - len(ds)) + ds
    mag_y = pad(ys)
    inverse = [1 - b for b in mag_y]
    comp, _ = bits_add(inverse, [0] * (width - 1) + [1])
    s = lambda lst: "".join(map(str, lst))
    total, carry = bits_add([0] + pad(xs), [1] + comp)
    if log is not None:
        log += [f"-y: прямий код 1.{s(mag_y)}", f"-y: зворотний код 1.{s(inverse)}",
                f"-y: додатковий код 1.{s(comp)}",
                f"сума: 0.{s(pad(xs))} + 1.{s(comp)} = {carry}{total[0]}.{s(total[1:])} (перенос {carry} відкидаємо)"]
    if total[0] == 0:
        return str(Num(total[1:], 2))
    back, _ = bits_add([1 - b for b in total[1:]], [0] * (width - 1) + [1])
    return "-" + str(Num(back, 2))


# ---------- допоміжні функції ----------
def int_to_str(n, base):
    out = ""
    while True:
        n, r = divmod(n, base)
        out = ALPHABET[r] + out
        if n == 0:
            return out


def calculate(x, op, y, base, digits=12, with_log=True):
    """Виконує дію; повертає (рядок результату, список кроків)."""
    log = [] if with_log else None
    a, b = Num.parse(x, base), Num.parse(y, base)
    if op == "+":
        res = str(a.plus(b, log))
    elif op == "-":
        res = str(a.minus(b, log))
    elif op in ("x", "X", "*"):
        res = str(a.times(b, log))
    elif op == "/":
        whole, frac, rem = a.divide(b, digits, log)
        res = str(whole) + ("," + frac if frac else "") + (f" (остача {rem})" if not frac and not rem.is_zero() else "")
    elif op == "c":
        if base != 2:
            raise ValueError("додатковий код реалізовано для двійкової системи")
        res = complement_minus(x, y, 16, log)
    else:
        raise ValueError("невідома дія: " + op)
    return res, log


def show(x, op, y, base, digits=12):
    res, log = calculate(x, op, y, base, digits)
    print(f"{x}({base}) {op} {y}({base})")
    for line in log:
        print("  " + line)
    print(f"Результат: {res}({base})\n")


def demo():
    a, b, c = 738, 681, 697            # числа варіанту 10 (N = 10, g = 251)
    s = int_to_str
    for x, op, y, base in [(s(a, 8), "+", s(c, 8), 8), (s(b, 16), "+", s(c, 16), 16),
                           (s(a, 2), "x", s(b, 2), 2), (s(c, 8), "x", s(b, 8), 8),
                           (s(a, 2), "-", s(b, 2), 2), (s(a, 8), "-", s(c, 8), 8),
                           (s(b, 2), "/", s(c, 2), 2), (s(a, 2), "c", s(b, 2), 2)]:
        show(x, op, y, base)


def self_test():
    rnd = random.Random(11)
    for _ in range(4000):
        base = rnd.randint(2, 16)
        p, q = rnd.randint(0, 10 ** 5), rnd.randint(1, 10 ** 5)
        a, b = Num.parse(int_to_str(p, base), base), Num.parse(int_to_str(q, base), base)
        assert int(str(a + b), base) == p + q
        if p >= q:
            assert int(str(a - b), base) == p - q
        assert int(str(a * b), base) == p * q
        whole, _, rem = a.divide(b)
        assert int(str(whole), base) == p // q and int(str(rem), base) == p % q
    for _ in range(2000):
        p, q = rnd.randint(0, 30000), rnd.randint(1, 30000)
        r = complement_minus(bin(p)[2:], bin(q)[2:], 16)
        assert (-int(r[1:], 2) if r.startswith("-") else int(r, 2)) == p - q
    assert calculate("1342", "+", "1271", 8, with_log=False)[0] == "2633"
    assert calculate("2A9", "+", "2B9", 16, with_log=False)[0] == "562"
    print("Усі тести пройдено: 4000 прикладів для основ 2..16 і 2000 для додаткового коду.")


def main():
    use_utf8()
    ap = argparse.ArgumentParser(description="Арифметика в системах числення (основи 2..16)")
    ap.add_argument("x", nargs="?")
    ap.add_argument("op", nargs="?")
    ap.add_argument("y", nargs="?")
    ap.add_argument("--base", type=int, default=2, help="основа системи (за замовчуванням 2)")
    ap.add_argument("--digits", type=int, default=12, help="цифр після коми для ділення")
    ap.add_argument("--demo", action="store_true")
    ap.add_argument("--test", action="store_true")
    args = ap.parse_args()
    try:
        if args.demo:
            demo()
        elif args.test:
            self_test()
        elif args.x and args.op and args.y:
            show(args.x, args.op, args.y, args.base, args.digits)
        else:
            print("Формат: x дія y основа (наприклад: 1342 + 1271 8). Порожній рядок - вихід.")
            while True:
                parts = input("> ").split()
                if not parts:
                    break
                try:
                    show(parts[0], parts[1], parts[2], int(parts[3]))
                except (ValueError, IndexError, ZeroDivisionError) as err:
                    print("Помилка:", err)
    except (ValueError, ZeroDivisionError) as err:
        print("Помилка:", err)
        sys.exit(1)


if __name__ == "__main__":
    main()
